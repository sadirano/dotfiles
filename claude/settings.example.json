{
  "statusLine": {
    "type": "command",
    "command": "pwsh -NonInteractive -File \"$HOME/.dotfiles/claude/statusline.ps1\""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.dotfiles/claude/hooks/guard_broad_kill.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
